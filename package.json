{
  "name": "vouch",
  "version": "0.1.0",
  "private": true,
  "description": "Vouch - AI PR Analysis GitHub App for detecting hallucinated dependencies and security anti-patterns",
  "scripts": {
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "build": "turbo run build",
    "demo": "turbo run build --filter=@vouch/api && node apps/api/dist/demo.js",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:studio": "turbo run db:studio",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@prisma/client": "^5.10.0",
    "prisma": "^5.10.0",
    "turbo": "^1.13.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
