# =============================================================================
# Vouch — copy to `.env` at the repo root and fill in real values
# =============================================================================

# --- API & Worker (required) ---
DATABASE_URL=postgresql://vouch:vouch@localhost:5432/vouch
REDIS_URL=redis://localhost:6379
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# Optional API tuning
# NODE_ENV=development
# PORT=3000
# LLM_CONFIDENCE_THRESHOLD=0.7
# Enables the /api/v1 admin endpoints (disabled when unset). 16+ chars.
# ADMIN_API_TOKEN=generate-a-long-random-string
# VOUCH_DASHBOARD_URL=http://localhost:3002
# VOUCH_MODE: deterministic (default, no LLM) | zero-cost (Ollama) | full (Anthropic)
# VOUCH_MODE=deterministic
# ANTHROPIC_API_KEY=sk-ant-...            # required only when VOUCH_MODE=full
# OLLAMA_BASE_URL=http://localhost:11434  # used only when VOUCH_MODE=zero-cost
# OLLAMA_MODEL=codellama:7b-code

# --- Dashboard (required at dev/start; placeholders OK for `next build` only) ---
NEXTAUTH_URL=http://localhost:3002
NEXTAUTH_SECRET=change-me-to-a-random-string-at-least-32-chars
GITHUB_ID=your-github-oauth-app-client-id
GITHUB_SECRET=your-github-oauth-app-client-secret
# GitHub logins allowed to use the dashboard (comma-separated).
# Optional in development; REQUIRED in production or all sign-ins are rejected.
DASHBOARD_ALLOWED_LOGINS=your-github-username
