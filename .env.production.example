# =============================================================================
# Vouch Production — copy values into Railway / Vercel / GitHub App settings
# =============================================================================

# --- PostgreSQL (Supabase / Railway / Neon) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/vouch?sslmode=require

# --- Redis (Upstash — use the rediss:// URL) ---
REDIS_URL=rediss://default:TOKEN@HOST:6379

# --- GitHub App (Developer Settings → GitHub Apps) ---
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=generate-a-long-random-string

# --- LLM mode ---
# deterministic = no LLM, no cost, nothing to provision (recommended for free hosting)
VOUCH_MODE=deterministic
# VOUCH_MODE=zero-cost   # local Ollama
# VOUCH_MODE=full        # Anthropic Haiku -> Sonnet (needs ANTHROPIC_API_KEY)
# ANTHROPIC_API_KEY=sk-ant-...
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=codellama:7b-code

# --- Dashboard (Vercel) — GitHub OAuth App (separate from GitHub App) ---
NEXTAUTH_URL=https://your-dashboard.vercel.app
NEXTAUTH_SECRET=generate-32-plus-character-secret
GITHUB_ID=Ov23li...
GITHUB_SECRET=...
VOUCH_DASHBOARD_URL=https://your-dashboard.vercel.app
# REQUIRED in production: GitHub logins allowed to use the dashboard.
# Without this, every sign-in is rejected (findings include private-repo code).
DASHBOARD_ALLOWED_LOGINS=your-github-username,teammate-username

# --- Optional ---
LLM_CONFIDENCE_THRESHOLD=0.7
NODE_ENV=production
PORT=3000
# Enables the /api/v1 admin endpoints (disabled when unset). 16+ chars.
# ADMIN_API_TOKEN=generate-a-long-random-string
